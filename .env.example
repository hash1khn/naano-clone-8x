# Next.js (browser-safe)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Canonical public origin. Set this on Vercel to:
# https://naano-clone-8x.vercel.app
# Leave unset locally so OAuth uses http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Server-only
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres URI for the Supabase CLI (db pull / db push).
# Dashboard → Project Settings → Database → Connect → URI
# Use the direct connection (port 5432), not the pooler (6543).
# Percent-encode special characters in the password.
DATABASE_URL=
